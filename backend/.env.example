# ============================================================
# KisanSathi Backend — Environment Configuration
# Copy to .env and fill in your values
# ============================================================

# --- App ---
APP_ENV=development
DEBUG=true
SECRET_KEY=CHANGE_ME_generate_with_python_secrets_token_hex_32
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Database ---
# Set DATABASE_URL for PostgreSQL, or SQLITE_FALLBACK=true for dev without Docker
DATABASE_URL=postgresql+asyncpg://kisansathi:kisansathi_dev_pw@localhost:5432/kisansathi
SQLITE_FALLBACK=false
# SQLITE_FALLBACK=true -> uses sqlite+aiosqlite:///./kisansathi_dev.db

# --- Redis (optional — uses in-memory fallback if absent) ---
REDIS_URL=redis://localhost:6379
REDIS_FALLBACK=true

# --- ChromaDB ---
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=kisansathi_knowledge

# --- IBM watsonx.ai ---
WATSONX_API_KEY=YOUR_IBM_CLOUD_API_KEY
WATSONX_PROJECT_ID=YOUR_WATSONX_PROJECT_ID
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Granite model IDs (update to latest available in your region)
GRANITE_TEXT_MODEL=ibm/granite-13b-instruct-v2
GRANITE_VISION_MODEL=ibm/granite-vision-3-2-2b
GRANITE_EMBED_MODEL=ibm/slate-125m-english-rtrvr
GRANITE_GUARDIAN_MODEL=ibm/granite-guardian-3-8b

# --- Mock mode (set true for demo without API key) ---
USE_MOCK_LLM=true

# --- Auth ---
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
OTP_EXPIRE_MINUTES=10
OTP_RATE_LIMIT_PER_HOUR=5

# --- File uploads ---
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# --- WhatsApp Cloud API ---
WHATSAPP_VERIFY_TOKEN=CHANGE_ME_random_string
WHATSAPP_APP_SECRET=YOUR_META_APP_SECRET
WHATSAPP_ACCESS_TOKEN=YOUR_META_PERMANENT_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID

# --- Weather (Open-Meteo, no key needed) ---
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# --- Market Data ---
# Optional: data.gov.in API key for live Agmarknet prices
# If absent, falls back to sample CSV
AGMARKNET_API_KEY=

# --- Observability ---
LOG_LEVEL=INFO
PROMETHEUS_ENABLED=true
OTEL_ENABLED=false
OTEL_ENDPOINT=http://localhost:4317

# --- Scheduler ---
DAILY_DIGEST_HOUR=6
WEATHER_SCAN_INTERVAL_HOURS=1
MARKET_REFRESH_INTERVAL_HOURS=24
